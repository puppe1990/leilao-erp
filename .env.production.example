# Copy to /etc/leilao-erp/env (chmod 600) on the server.
# Required for ENV=production.

PORT=:8080
ENV=production
APP_URL=https://seu-dominio.com
DB_PATH=/var/lib/leilao-erp/app.db

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Optional but recommended behind Caddy/nginx
TRUSTED_PROXIES=127.0.0.1
LOCALE=pt

# Optional paths when WorkingDirectory is not the app root
# STATIC_DIR=/opt/leilao-erp/current/web/static
# TEMPLATES_DIR=/opt/leilao-erp/current/web/templates
# Product photos/videos — outside the release tree (default: $DB_PATH/../uploads)
UPLOADS_DIR=/var/lib/leilao-erp/uploads

# Backblaze B2 (allPublic bucket). When set, new uploads skip local disk.
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
B2_BUCKET=eletronicos-phoenix
B2_REGION=us-east-005
B2_PUBLIC_BASE=https://f005.backblazeb2.com/file/eletronicos-phoenix

# Optional admin token / SMTP (password reset emails)
ADMIN_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
