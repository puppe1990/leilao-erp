# Copy to /etc/leilao-erp/env (chmod 600) on the server.
# Required for ENV=production.

PORT=:8080
ENV=production
APP_URL=https://seu-dominio.com
DB_PATH=/var/lib/leilao-erp/app.db

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Optional but recommended behind Caddy/nginx
TRUSTED_PROXIES=127.0.0.1
LOCALE=pt

# Optional paths when WorkingDirectory is not the app root
# STATIC_DIR=/opt/leilao-erp/current/web/static
# TEMPLATES_DIR=/opt/leilao-erp/current/web/templates

# Optional admin token / SMTP (password reset emails)
ADMIN_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
