[Unit]
Description=leilao-erp (Cais)
After=network.target

[Service]
Type=exec
User=leilao
Group=leilao
WorkingDirectory=/opt/leilao-erp/current
EnvironmentFile=/etc/leilao-erp/env
ExecStart=/opt/leilao-erp/current/bin/server
Restart=always
RestartSec=5
MemoryMax=192M
LimitNOFILE=65535

# Hardening (optional; adjust if the unit fails on your distro)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
